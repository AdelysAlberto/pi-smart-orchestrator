{
  "enabled": true,
  "maxInFlight": 3,
  "debug": false,
  "agentsDir": "/Volumes/Datos/Projects/utils/agents/agents-pi/agents",
  "logFile": "~/.pi/agent/smart-orchestrator.log",
  "theme": {
    "colors": {
      "active": "#00E5FF",
      "header": "#A3BF06",
      "action": "#FF6B00",
      "surface": "#0B0F17"
    }
  },
  "workflows": {
    "plan-and-build": {
      "description": "Dos etapas: plan de arquitectura aprobado por el usuario, seguido de la construccion",
      "steps": [
        {
          "step": 1,
          "name": "Diseno de Arquitectura",
          "agent": "sheldon",
          "effort": "high",
          "requireApproval": true,
          "rules": ["engineering-invariants", "runtime", "verification-checklist", "commits"]
        },
        {
          "step": 2,
          "name": "Construccion de Codigo",
          "agent": "homero",
          "effort": "low",
          "inputFrom": "step 1",
          "rules": [
            "engineering-invariants",
            "verification-checklist",
            "commits",
            "frontend",
            "backend",
            "react-native"
          ]
        }
      ]
    },
    "security-audit": {
      "description": "Auditoria de seguridad seguida de revision de estandares",
      "steps": [
        {
          "step": 1,
          "name": "Auditoria de Vulnerabilidades",
          "agent": "gorgory",
          "effort": "high"
        },
        {
          "step": 2,
          "name": "Revision de Estandares",
          "agent": "tio-bob",
          "effort": "low",
          "inputFrom": "step 1"
        }
      ]
    }
  }
}
